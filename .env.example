# FutBolia — Environment template
# Copy to services/api/.env for local development.
# NEVER commit real secrets.

# --- App ---
NODE_ENV=development
APP_NAME=FutBolia
APP_URL=http://localhost:3000
PORT=3000
API_PREFIX=api/v1

# --- Database (PostgreSQL) ---
# Set DATABASE_ENABLED=false to boot the API without Postgres (local UI/API smoke tests).
#
# Local Docker (default):
#   docker compose up -d
#   DATABASE_HOST=localhost / DATABASE_SSL=false
#
# Shared DEV (Neon) — see docs/shared-database.md:
#   Prefer DATABASE_URL (pooled) + DATABASE_SSL=true
#   Or discrete host vars: DATABASE_HOST=ep-xxxx....neon.tech
#
# Render production — see docs/render-api.md:
#   DATABASE_URL + DATABASE_SSL=true + DATABASE_SYNC=true (until migrations)
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_ENABLED=true
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=futbolia
DATABASE_PASSWORD=futbolia_dev_change_me
DATABASE_NAME=futbolia_dev
DATABASE_SSL=false
DATABASE_SYNC=
DATABASE_LOGGING=true

# --- Auth (Phase 2) ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Email (Phase 2) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=FutBolia <noreply@futbolia.app>
# RESEND_API_KEY=

# --- Storage (Phase 2+) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=futbolia-dev
# R2_PUBLIC_BASE_URL=

# --- Push (Phase 11) ---
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# --- Security ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
CORS_ORIGINS=http://localhost:*,http://10.0.2.2:3000

# --- Mobile (document only; configure in Flutter flavors later) ---
# API_BASE_URL_ANDROID_EMULATOR=http://10.0.2.2:3000/api/v1
# API_BASE_URL_IOS_SIMULATOR=http://localhost:3000/api/v1
